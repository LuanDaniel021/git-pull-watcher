# Endereço público do Cloudflare Worker, sem barra no final
WATCHER_URL=https://git-pull-watcher.seu-subdominio.workers.dev

# Mesmo valor cadastrado como CLIENT_TOKEN no Runtime do Worker
CLIENT_TOKEN=coloque-seu-token-aqui

# Caminho absoluto do repositório que será atualizado
REPOSITORY_PATH=C:/caminho/para/git-pull-watcher
